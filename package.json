{
  "name": "survey-tests",
  "version": "1.0.0",
  "description": "Frontend tests for survey application",
  "scripts": {
    "build": "vite build --config frontend/vite.config.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "pretest:e2e": "npm run build",
    "build:watch": "vite build --config frontend/vite.config.ts --watch",
    "test:unit": "vitest run --config frontend/vitest.config.mts",
    "build:core": "node scripts/build-core.mjs",
    "pretest": "npm run build:core"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
