{
  "name": "survey-tests",
  "version": "1.0.0",
  "description": "Frontend tests for survey application",
  "scripts": {
    "build": "vite build --config frontend/vite.config.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "pretest:e2e": "npm run build",
    "build:watch": "vite build --config frontend/vite.config.ts --watch",
    "test:unit": "vitest run --config frontend/vitest.config.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
