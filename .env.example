# Copy to .env and adjust for your deployment. Do NOT commit .env.

# Flask session secret. REQUIRED in production (when DATA_DIR is set).
# Generate one with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Admin dashboard password. Must NOT be the default 'admin123' in production.
ADMIN_PASSWORD=

# Persistent data directory. Setting this enables production mode:
# requires SECRET_KEY, enforces HTTPS cookies, stores the DB + audit log here.
DATA_DIR=

# Comma-separated access codes. Empty = no referral gate.
REFERRAL_CODES=

# Auto-fill forms, fewer trials, bypass referral. Never enable in production.
DEV_MODE=false

# Tile order in the three-tile grid: MAB (Mask, A, B) or AMB.
TILE_LAYOUT=MAB

# Server port (used by `python -m src.survey.app`).
PORT=5000
